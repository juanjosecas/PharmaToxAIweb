---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/publications/' | absolute_url }}</loc></url>
  {% assign public_whitepapers = site.whitepapers | where_exp: 'item', 'item.published != false' %}
  {% if public_whitepapers.size > 0 %}
  <url><loc>{{ '/whitepapers/' | absolute_url }}</loc></url>
  {% for paper in public_whitepapers %}
  <url><loc>{{ paper.url | absolute_url }}</loc></url>
  {% endfor %}
  {% endif %}
</urlset>
